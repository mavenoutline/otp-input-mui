{
  "name": "@mavenoutline/otp-input-mui",
  "version": "2.0.0",
  "description": "Accessible OTP / PIN / verification-code input for React & Next.js built on MUI: paste & SMS autofill, masking, resend timer, form support.",
  "keywords": [
    "otp",
    "mui",
    "material-ui",
    "pin",
    "react",
    "nextjs",
    "component",
    "input",
    "one-time-password",
    "verification-code",
    "2fa",
    "mfa",
    "otp-input",
    "pin-input",
    "resend-timer"
  ],
  "author": "MavenOutline",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mavenoutline/otp-input-mui.git"
  },
  "bugs": {
    "url": "https://github.com/mavenoutline/otp-input-mui/issues"
  },
  "homepage": "https://github.com/mavenoutline/otp-input-mui",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^6.0.0 || ^7.0.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^18.1.0 || ^19.0.0",
    "react-dom": "^18.1.0 || ^19.0.0",
    "typescript": "^5.6.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.2.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/dom": "^10.4.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
